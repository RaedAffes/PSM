# Set these values in a local .env before starting the application.
# JWT_SECRET and PSM_ADMIN_PASSWORD are required for a usable deployment.
# Never commit real secrets.

PSM_ADMIN_EMAIL=admin@example.com
PSM_ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-bytes
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Docker defaults:
# PSM_SQLITE_PATH=/var/lib/psm/psm.db
# PSM_STORAGE_ROOT=/var/lib/psm/uploads
# PSM_STORAGE_MAX_FILE_SIZE=10485760
# PORT=2026
